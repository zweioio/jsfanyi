{
  "manifest_version": 3,
  "name": "即时翻译",
  "version": "1.2",
  "description": "集成 Google、AI 双引擎，翻译双向回译核对，让每一句翻译的准确性都清晰可见",
  "permissions": ["storage", "clipboardRead", "sidePanel", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "即时翻译"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "在网页上打开悬浮窗"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "icons/icon.png",
        "icons/logo_extension.png",
        "icons/enter.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
